# RAG labor – Azure OpenAI beállítások. Másold .env néven, és töltsd ki (a .env ne kerüljön verziókezelésbe!).
# Az Azure portálon / AI Foundryben: az erőforrás "Keys and Endpoint" oldala, illetve a deploymentek listája.

AZURE_OPENAI_ENDPOINT=https://<erőforrás-neve>.openai.azure.com
AZURE_OPENAI_API_KEY=<kulcs>
AZURE_OPENAI_API_VERSION=2025-04-01-preview

# chat modell: a deployment neve és a mögötte lévő modell neve (ha a deployment neve más, a modellnevet akkor is add meg:
# ebből tudja a LlamaIndex és a LiteLLM/GraphRAG, hogy reasoning modellről van szó)
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-5.4-mini
AZURE_OPENAI_CHAT_MODEL=gpt-5.4-mini

# embedding modell
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
