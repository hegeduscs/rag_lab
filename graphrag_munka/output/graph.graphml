      <data key="d0">ÖSSZEGHATÁR</data>
      <data key="d1">Az a pénzügyi sáv, amelybe eső pályázati önrész esetén magasabb szintű döntéshozói és képviseleti szereplők vesznek részt.</data>
      <data key="d2">1</data>
    </node>
