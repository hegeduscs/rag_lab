      <data key="d2">1</data>
    </node>
    <node id="KÖRLEVÉL">
      <data key="d0">OKIRAT</data>
      <data key="d1">Általános írásbeli utasítás vagy tájékoztató dokumentum, jelen szövegben a 27/2017. számú kancellári körlevél formájában szerepel</data>
      <data key="d2">0</data>
    </node>
    <node id="KERESETKIEGÉSZÍTÉSRE VONATKOZÓ KANCELLÁRI EGYETÉRTÉS ÉS KANCELLÁRI ENGEDÉLY ELJÁRÁSRENDJE">
      <data key="d0">OKIRAT</data>
      <data key="d1">A 7/2024. számú Kancellári Utasításban szabályozott eljárásrend, amely a keresetkiegészítésre vonatkozó kancellári egyetértés és kancellári engedély folyamatát írja le</data>
      <data key="d2">1</data>
    </node>
