      <data key="d0">FOLYAMAT</data>
      <data key="d1">Olyan beszerzési eljárás, amelynél nem szükséges beszerzési eljárás lefolytatása, és 200 000 Ft-ig külön szabályok vonatkoznak rá.</data>
      <data key="d2">4</data>
    </node>
    <node id="HATÓSÁGI DÍJAK, BÍRSÁGOK, ADÓK">
      <data key="d0">FOLYAMAT</data>
      <data key="d1">Olyan kötelezettségvállalási tárgy, amelyre az összeghatártól független speciális döntési és felelősségi rend vonatkozik.</data>
      <data key="d2">1</data>
    </node>
    <node id="2 000 000 FT">
      <data key="d0">ÖSSZEGHATÁR</data>
      <data key="d1">A beszerzési eljárások egyik meghatározó pénzügyi küszöbe, amely alatt és felett eltérő döntési szabályok érvényesek.</data>
      <data key="d2">4</data>
    </node>
    <node id="10 000 000 FT">
      <data key="d0">ÖSSZEGHATÁR</data>
      <data key="d1">A nagyobb beszerzések felső pénzügyi küszöbe a táblázatban, amelyhez külön eljárási és döntési rend kapcsolódik.</data>
      <data key="d2">2</data>
    </node>
