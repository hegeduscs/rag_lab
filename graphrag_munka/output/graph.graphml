    <node id="BEVÉTELI PÉNZÜGYI KÖTELEZETTSÉGVÁLLALÁSOK">
      <data key="d0">FOLYAMAT</data>
      <data key="d1">Olyan pénzügyi kötelezettségvállalási ügyek összessége, amelyek bevételi oldalon jelentkeznek, például megbízásos projektek formájában.</data>
      <data key="d2">1</data>
    </node>
    <node id="MEGBÍZÁSOS PROJEKTEK">
      <data key="d0">FOLYAMAT</data>
      <data key="d1">Bevételi jellegű, nem nevesített kötelezettségvállalási projektek típusa, amely a pénzügyi kötelezettségvállalások egyik példája.</data>
      <data key="d2">1</data>
    </node>
    <node id="ÖNRÉSZ">
      <data key="d0">ÖSSZEGHATÁR</data>
      <data key="d1">A pályázatokhoz kapcsolódó saját forrásrészt jelölő pénzügyi összeg, amelyhez a szövegben külön döntési és felelősségi szabályok tartoznak.</data>
      <data key="d2">3</data>
    </node>
