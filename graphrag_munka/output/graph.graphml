      <data key="d2">2</data>
    </node>
    <node id="3 AJÁNLATOS BESZERZÉS">
      <data key="d0">FOLYAMAT</data>
      <data key="d1">Olyan beszerzési eljárás, amelynél három ajánlat alapján történik a beszerzés, és 2 000 000 Ft feletti kategóriában szerepel.</data>
      <data key="d2">2</data>
    </node>
